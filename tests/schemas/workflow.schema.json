{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spec Kit workflow.yml",
  "type": "object",
  "required": ["schema_version", "workflow", "steps"],
  "properties": {
    "schema_version": { "type": "string" },
    "workflow": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$" },
        "author": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "speckit_version": { "type": "string" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {},
          "prompt": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["gate", "do-while", "command"] },
        "command": { "type": "string" },
        "integration": { "type": "string" },
        "input": { "type": "object" },
        "message": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "on_reject": { "type": "string" },
        "condition": { "type": "string" },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" }
        }
      }
    }
  }
}
